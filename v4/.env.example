# VoCS V4 Environment Variables
# Copy this to .env and fill in your actual values

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Slack Webhook URLs (one per team/channel)
SLACK_WEBHOOK_CHECKOUT=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_CATALOGUE=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_ACCOUNT=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
